<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hosts the Node backend inside IIS. Needs the IIS "HttpPlatformHandler" module.
  IIS starts node.exe on the first request, restarts it if it stops, and forwards requests to it.
  setup-iis.ps1 replaces __NODE_EXE__ and __APP_DIR__ with real paths on the server.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="__NODE_EXE__"
      arguments="&quot;__APP_DIR__\src\server.js&quot;"
      startupTimeLimit="60"
      requestTimeout="00:10:00"
      stdoutLogEnabled="true"
      stdoutLogFile="__APP_DIR__\logs\node">
      <environmentVariables>
        <!-- IIS picks a free internal port; server.js listens on PORT -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Runs the INV API sync schedules (see src/sync) -->
        <environmentVariable name="SCHEDULER_ENABLED" value="true" />
      </environmentVariables>
    </httpPlatform>
    <!-- Starts Node as soon as IIS starts (with preloadEnabled on the site), so the schedules
         run after a reboot even if nobody has opened the site yet -->
    <applicationInitialization>
      <add initializationPage="/api/health" />
    </applicationInitialization>
  </system.webServer>
</configuration>
